
{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Clannect Support Center",
  "colors": {
    "primary": "#fe4133",
    "light": "#fe4133",
    "dark": "#fe4133"
  },
  "favicon": "/favicon.png",
  "navigation": {
    "tabs": [
      {
        "tab": "Core Values",
        "groups": [
          {
            "group": "Introduction",
            "pages": [
              "index",
              "about",
              "ourvision",
              "ourmission"
            ]
          },
          {
            "group": "Inside Clannect",
            "pages": [
              "inside/philosophy",
              "inside/design-principles",
              "inside/development-approach",
              "inside/our-team",
              "inside/roadmap-philosophy"
            ]
          },
          {
            "group": "Culture & Ethics",
            "pages": [
              "culture-and-ethics/community-guidelines",
              "culture-and-ethics/moderation-philosophy",
              "culture-and-ethics/gamification-ethics",
              "culture-and-ethics/privacy-and-safety-principles",
              "culture-and-ethics/team-culture"
            ]
          }
          
        ]
      },

      {
        "tab": "Policies",
        "groups": [
          {
            "group": "All Policies",
            "pages": [
              "policies/terms-of-service",
              "policies/privacy-policy",
              "policies/refund-policy",
              "policies/pricing"
            ]
          }
        ]
      }
      
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Status",
          "href": "https://status.clannect.com",
          "icon": "book-open-cover"
        }
      ]
    }
  },
  "logo": "/logo/ClannectLogo.png",
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@clannect.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Visit Clannect",
      "href": "https://app.clannect.com"
    }
  },
  "contextual": {
    "options": [
     "copy",
     "view",
     "chatgpt",
     "claude",
     "perplexity",
     "mcp",
     "cursor",
     "vscode"
   ]
  },
  "footer": {
    "socials": {
      "website": "https://clannect.com",
      "youtube": "https://www.youtube.com/@ClannectOfficial",
      "instagram": "https://www.instagram.com/getclannect/",
      "discord": "https://discord.gg/TFEhtZgjJd"
    }
  },
  "description": "Welcome to our Support Center, you can read documents, check guidelines, policies, blogs and contact with our team or Clannect Support AI from this website!",
  "background": {
    "decoration": "windows"
  },
  "errors": {
    "404": {
      "title": "Looks like you are lost...",
      "description": "The page you are looking for does not exists, did you mean one of these?"
    }
  },
  "search": {
    "prompt": "Search in Support Center"
  },
  "appearance": {
    "default": "system"
  },
  "fonts": {
    "heading": {
      "family": "Inter"
    }
  },
  "banner": {
    "content": "Support Center is still under development. We’re continuously adding new content! If you have any questions, contact with support@clannect.com",
    "dismissible": true
  },

  "settings": {
  "customScripts": [
    "/crisp.js"
  ]
}
}
